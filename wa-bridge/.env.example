# Salin file ini menjadi .env lalu isi.

# Nomor WA PRIBADIMU (yang boleh memerintah bot). Format internasional tanpa + atau spasi.
# Boleh lebih dari satu, pisahkan dengan koma. Pesan dari nomor lain diabaikan.
OWNER_NUMBERS=62812xxxxxxxx

# Nomor KHUSUS untuk bot. Jika diisi, penautan memakai kode 8 huruf.
# Jika dikosongkan, penautan memakai QR di terminal.
WA_BOT_NUMBER=

# --- opsional ---
# Folder repo yang dikerjakan Claude (default: folder induk wa-bridge).
# REPO_DIR=..
# Izin Claude. acceptEdits = boleh mengedit file tanpa bertanya.
# CLAUDE_PERMISSION_MODE=acceptEdits
# Perintah shell yang diizinkan (selain edit file). Tambah seperlunya, mis. Bash(npm *).
# CLAUDE_ALLOWED_TOOLS=Bash(git *),Bash(graphify *)
# Batas waktu satu tugas, dalam menit.
# CLAUDE_TIMEOUT_MIN=20
